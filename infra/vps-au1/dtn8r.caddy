dtn8r-api.inspiredjourneys.dev {
    tls /etc/caddy/ssl/inspiredjourneys.dev/origin-cert.pem /etc/caddy/ssl/inspiredjourneys.dev/origin-cert.key

    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @websockets {
        reverse_proxy 127.0.0.1:9012 {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        }
    }

    handle {
        reverse_proxy 127.0.0.1:9013 {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        }
    }
}
