xp-api.stevepryde.com {
    tls /etc/caddy/ssl/stevepryde.com/origin-cert.pem /etc/caddy/ssl/stevepryde.com/origin-cert.key

    handle /ws* {
        reverse_proxy 127.0.0.1:9002 {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        }
    }

    handle {
        reverse_proxy 127.0.0.1:9003 {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        }
    }
}
